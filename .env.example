# ============================================================
# AI 模拟面试官 - 环境变量示例
# 用法：复制本文件为 .env 并填入真实值；.env 不会被提交到 git
# ============================================================

# ---------- DeepSeek（聊天/推理，OpenAI 兼容协议） ----------
# 获取地址：https://platform.deepseek.com/
# 占位符：务必替换为你自己的真实 Key，禁止把真实 Key 写入本示例文件
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话模型（推理节点统一使用；可在下方按节点覆写）
DEEPSEEK_MODEL=deepseek-chat
# 各节点温度/模型覆写（留空则使用 DEEPSEEK_MODEL 与默认温度）
LLM_MODEL_QUESTION=
LLM_MODEL_FOLLOWUP=
LLM_MODEL_EVAL=
LLM_MODEL_REWRITE=

# ---------- 评测 judge（RAGAS 交叉验证，可选） ----------
# 仅用于离线 RAGAS 评判；留空则回落到 LLM_MODEL_EVAL / DEEPSEEK（生产零行为变化）。
# 用于「异源 judge 交叉验证」时，可指向另一方模型（如 SiliconFlow 上的 Qwen）。
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=

# ---------- SiliconFlow 硅基流动（Embedding / Rerank） ----------
# 获取地址：https://cloud.siliconflow.cn/ （bge-m3 / bge-reranker 有免费额度）
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# bge-m3 向量维度（固定 1024，勿改）
EMBEDDING_DIM=1024

# ---------- Qdrant 向量库 ----------
# 模式：local = 本地文件模式（Windows 开发默认，无需 Docker）；server = 连接 Qdrant 服务（Docker/云端）
QDRANT_MODE=local
# local 模式的数据目录
QDRANT_PATH=./data/qdrant_storage
# server 模式的地址与 API Key（QDRANT_MODE=server 时生效）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 集合名
QDRANT_COLLECTION=interview_kb

# ---------- 检索管线参数 ----------
RETRIEVAL_ENABLE_MULTI_QUERY=true
RETRIEVAL_ENABLE_HYDE=false
RETRIEVAL_MULTI_QUERY_N=3
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_BM25_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_TOP_K=6
# Agentic RAG：检索质量自评最大重写轮数
ADAPTIVE_MAX_REWRITE_ROUNDS=2

# ---------- 切块参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 会话 / 存储 ----------
SQLITE_PATH=./data/interview.db
# 上传限制
UPLOAD_MAX_BYTES=10485760

# ---------- 面试默认参数 ----------
INTERVIEW_DEFAULT_QUESTIONS=5
INTERVIEW_MAX_FOLLOWUPS=2

# ---------- API 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501

# ---------- 可观测性 ----------
# 不配置 Langfuse 三个变量时，自动降级为本地 JSONL 结构化日志（logs/ 目录）
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
LOG_DIR=./logs
LOG_LEVEL=INFO
